# Copy this file to ".env" (same folder) and fill in the values. Never share or commit your real .env.

# --- WhatsApp receipts (see README: "Receipt, thank-you and location on WhatsApp") ---
# Long-lived token of a System User in Meta Business Settings (permission: whatsapp_business_messaging)
WHATSAPP_TOKEN=
# "Phone number ID" of your restaurant number in Meta -> WhatsApp -> API Setup (a long number, NOT the phone number)
WHATSAPP_PHONE_ID=
# Name and language of the approved template (the README has the exact text)
WHATSAPP_TEMPLATE=visit_thanks
WHATSAPP_LANG=en
# 1 = attach the PDF receipt to the WhatsApp message (the template then needs a Document header). 0 = text only.
WHATSAPP_ATTACH_PDF=0
# Only used by `node tools/whatsapp-check.js`:
WHATSAPP_WABA_ID=
WHATSAPP_EXPECTED_NUMBER=919673223756

# --- Staff and server ---
# STAFF_PIN=change-me
# PORT=3000

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_URL=https://your-domain
